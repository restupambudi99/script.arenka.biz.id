{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arenka-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "arenka.biz.id", "custom_domain": true },
		{ "pattern": "script.arenka.biz.id", "custom_domain": true }
	],
	"vars": {
		"AI_API_BASE_URL": "http://38.47.191.228:20128/v1",
		"AI_MODEL": "kr/claude-sonnet-4.5",
	},
	"secrets": { "required": ["AI_API_KEY"] },
	"kv_namespaces": [{ "binding": "SESSION", "id": "79fef95a158c4c60a5f6b0fd21a4f3db" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arenka-emdash",
			"database_id": "d77c1fa9-ebd4-4d05-b66e-98b0587fb5c2",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "arenka-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
